# LLM — 둘 중 하나만 설정하면 된다
# (A) vLLM 등 OpenAI 호환 서버: LLM_BASE_URL 과 서빙 중인 모델 경로/이름을 지정 (API 키 불필요)
LLM_BASE_URL=http://10.163.214.106:8000/v1
LLM_MODEL=/mnt/d/sungyong/qwen
# (B) OpenAI API: LLM_BASE_URL 은 비우고 키를 지정
OPENAI_API_KEY=
LLM_TIMEOUT=30

# Database
DATABASE_URL=sqlite:///./afpa.db

# App
APP_ENV=development
LOG_LEVEL=INFO

# 외부 금융 API (예: 금융감독원 금융상품 API)
FSS_API_KEY=
